# Local development only. Run pnpm setup:local to generate random credentials.
POSTGRES_USER=mobility
POSTGRES_DB=mobility
POSTGRES_PASSWORD=
DATABASE_URL=
REDIS_PASSWORD=
MOBILITY_JWT_SECRET=

# Generated by setup:local; copied only to Core.
BETTER_AUTH_SECRET=

# Interactive EVE approval/rejection is the default. Campaign is an explicit experimental opt-in.
MOBILITY_BUDGET_MODE=interactive
