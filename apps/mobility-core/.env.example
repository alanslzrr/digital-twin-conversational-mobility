ACTIVE_WINDOW_SECONDS=1800
OTP_SANDBOX_ENABLED=false
LOCAL_DATA_DIR=
OTP_URL=http://127.0.0.1:8801/otp/gtfs/v1

BETTER_AUTH_SECRET=
EVALUATION_ORIGIN=http://127.0.0.1:3000

# Disabled by default, and always disabled in previews. Enable only after explicit approval.
MOBAI_LLM_ENABLED=false
MOBAI_EMAIL_ENABLED=false
MOBAI_EMAIL_TRACKING_DISABLED=false
MOBAI_EMAIL_FROM=mobai@alansalazar.dev
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
