# EVE has no database, cache, provider or Blob credentials.
MOBILITY_MCP_URL=http://127.0.0.1:3001/mcp
MOBILITY_MCP_TOKEN=
# Choose an available OpenAI model ID from the Gateway catalog before a model call.
# No default model is selected and no calls run during setup/build/tests.
EVE_MODEL=
# Local development only. On Vercel prefer project OIDC + configured OpenAI BYOK.
AI_GATEWAY_API_KEY=
