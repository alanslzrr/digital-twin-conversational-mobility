# EVE has no database, cache, mobility-source or Blob credentials.
MOBILITY_MCP_URL=http://127.0.0.1:3001/mcp
MOBILITY_MCP_TOKEN=
# All model traffic goes through the fixed Core transport. No provider keys in Web.
MOBILITY_BUDGET_MODE=interactive
# Better Auth runs in Core; no database or auth signing key in the web app.
EVALUATION_ORIGIN=http://127.0.0.1:3000

# Optional private listening port, independent of the public HTTPS origin.
MOBAI_WEB_PORT=3000
# A single-node deployment must keep this directory on persistent Block Storage.
# WORKFLOW_LOCAL_DATA_DIR=/srv/mobai/workflow
