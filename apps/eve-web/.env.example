# EVE has no database, cache, mobility-source or Blob credentials.
MOBILITY_MCP_URL=http://127.0.0.1:3001/mcp
MOBILITY_MCP_TOKEN=
# Direct OpenAI Responses API, model pinned to gpt-6-luna in src/model.ts.
# Run pnpm configure:openai to copy ONLY this key from root .env.local.
# No model calls run during setup/build/unit tests; no Gateway or fallback.
OPENAI_API_KEY=
# Better Auth runs in Core; no database or auth signing key in the web app.
EVALUATION_ORIGIN=http://127.0.0.1:3000
